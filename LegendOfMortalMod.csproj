<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net472</TargetFramework>
        <LangVersion>latest</LangVersion>
        <AssemblyName>LegendOfMortalMod</AssemblyName>
        <RootNamespace>LegendOfMortalMod</RootNamespace>
        <Version>1.1.1</Version>
        <Product>LegendOfMortalMod</Product>
        <DebugType>none</DebugType>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <RestoreAdditionalProjectSources>https://nuget.bepinex.dev/v3/index.json</RestoreAdditionalProjectSources>
        <GamePath Condition="'$(GamePath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\LegendOfMortal</GamePath>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BepInEx.Unity.Mono" Version="6.0.0-be.697" IncludeAssets="compile" />
        <PackageReference Include="UnityEngine.Modules" Version="2020.3.49" IncludeAssets="compile" />
    </ItemGroup>

    <!-- Game assemblies, copied from <game>\Mortal_Data\Managed -->
    <ItemGroup>
        <Reference Include="assembly-libaries\Mortal.*.dll" Private="false" />
    </ItemGroup>

    <!-- Copy the built plugin into the game when it is installed. Override with -p:GamePath=... -->
    <Target Name="DeployToGame" AfterTargets="Build" Condition="Exists('$(GamePath)\BepInEx\plugins')">
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GamePath)\BepInEx\plugins\LegendOfMortalMod" />
    </Target>
</Project>
